<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controller.GameController">

    <children>

        <!-- Background map -->
        <ImageView fx:id="backgroundImage" preserveRatio="false">
            <image><Image url="@../img/map.jpg" /></image>
        </ImageView>

        <!-- Game board pane (tokens, question cards) -->
        <Pane fx:id="gamePane" prefWidth="1920.0" prefHeight="1080.0" />

        <!-- HUD overlay: mini-HUD (top left) + Help/Settings (top right), absolute anchors -->
        <AnchorPane pickOnBounds="false">
            <children>

                <!-- Mini-HUD : current player + quest progress, always visible -->
                <VBox spacing="4.0" pickOnBounds="false"
                      AnchorPane.topAnchor="15.0" AnchorPane.leftAnchor="15.0">
                    <Label fx:id="hudPlayerLabel" text=""
                           style="-fx-text-fill: white;
                                  -fx-font-family: 'Consolas';
                                  -fx-font-size: 16;
                                  -fx-font-weight: bold;
                                  -fx-effect: dropshadow(gaussian, black, 4, 0.6, 0, 1);" />

                    <Label fx:id="hudQuestLabel" text="" wrapText="true" maxWidth="320.0"
                           style="-fx-text-fill: #cccccc;
                                  -fx-font-family: 'Consolas';
                                  -fx-font-size: 12;
                                  -fx-effect: dropshadow(gaussian, black, 3, 0.5, 0, 1);" />
                </VBox>

                <!-- Help + Settings -->
                <HBox spacing="10.0"
                      AnchorPane.topAnchor="15.0" AnchorPane.rightAnchor="15.0">
                    <Button fx:id="helpButton" onAction="#onHelp"
                            contentDisplay="GRAPHIC_ONLY" pickOnBounds="true"
                            style="-fx-background-color: transparent; -fx-padding: 0;
                                   -fx-border-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="60.0" preserveRatio="true" smooth="true">
                                <image><Image url="@../img/Assets/HelpBtn.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="settingsIGButton" onAction="#onSettingsIG"
                            contentDisplay="GRAPHIC_ONLY" pickOnBounds="true"
                            style="-fx-background-color: transparent; -fx-padding: 0;
                                   -fx-border-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="60.0" preserveRatio="true" smooth="true">
                                <image><Image url="@../img/Assets/SettingsIGBtn.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <Button fx:id="exitButton" onAction="#onExitGame"
                            contentDisplay="GRAPHIC_ONLY" pickOnBounds="true"
                            style="-fx-background-color: transparent; -fx-padding: 0;
                                   -fx-border-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitHeight="60.0" preserveRatio="true" smooth="true">
                                <image><Image url="@../img/Assets/ExitBtnModal.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>
                </HBox>

            </children>
        </AnchorPane>

        <!--
            HelpModal overlay — hidden by default.

            HelpModal.png already contains all static rule text (Deployment Protocol,
            Sector Legend, etc.). We only overlay the two dynamic values:
              • helpPlayerLabel : current player's name    → after "CURRENT OPERATIVE :"
              • helpQuestLabel  : active quest description → after "PRIMARY OBJECTIVE:"

            ── Fine-tuning ──────────────────────────────────────────────────────
            If the labels don't land exactly in the right spot, adjust:
              helpPlayerLabel  → topAnchor / leftAnchor  (line ~74-75)
              helpQuestLabel   → topAnchor / leftAnchor  (line ~82-83)
            Coordinates are in the 920 × 524 px container space.
        -->
        <StackPane fx:id="helpModalOverlay"
                   visible="false"
                   style="-fx-background-color: rgba(0,0,0,0.65);">

            <StackPane maxWidth="920.0" maxHeight="524.0">

                <!-- Modal background image (contains all static rule text) -->
                <ImageView fitWidth="920.0" fitHeight="524.0"
                           preserveRatio="true" smooth="true">
                    <image><Image url="@../img/Assets/HelpModal.png" /></image>
                </ImageView>

                <!-- Absolute overlay for dynamic content only -->
                <AnchorPane pickOnBounds="false"
                            style="-fx-background-color: transparent;">

                    <!-- Exit button — top-right corner of the modal frame -->
                    <Button onAction="#onCloseHelp"
                            contentDisplay="GRAPHIC_ONLY" pickOnBounds="true"
                            AnchorPane.topAnchor="60.0" AnchorPane.rightAnchor="130.0"
                            style="-fx-background-color: transparent; -fx-padding: 0;
                                   -fx-border-color: transparent; -fx-cursor: hand;">
                        <graphic>
                            <ImageView fitWidth="44.0" fitHeight="44.0"
                                       preserveRatio="true" smooth="true">
                                <image><Image url="@../img/Assets/ExitBtnModal.png" /></image>
                            </ImageView>
                        </graphic>
                    </Button>

                    <!-- Current player name (value after "CURRENT OPERATIVE :" in image) -->
                    <Label fx:id="helpPlayerLabel" text=""
                           AnchorPane.topAnchor="372.0" AnchorPane.leftAnchor="580.0"
                           style="-fx-text-fill: white;
                                  -fx-font-family: 'Consolas';
                                  -fx-font-size: 15;
                                  -fx-font-weight: bold;" />

                    <!-- Active quest description (value after "PRIMARY OBJECTIVE:" in image) -->
                    <Label fx:id="helpQuestLabel" text=""
                           wrapText="true" maxWidth="400.0"
                           AnchorPane.topAnchor="420.0" AnchorPane.leftAnchor="430.0"
                           style="-fx-text-fill: #cccccc;
                                  -fx-font-family: 'Consolas';
                                  -fx-font-size: 12;" />

                </AnchorPane>
            </StackPane>
        </StackPane>

    </children>
</StackPane>
