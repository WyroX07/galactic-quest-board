<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.controller.SettingsGameController"
            prefWidth="700.0"
            prefHeight="350.0"
            minWidth="700.0"
            minHeight="350.0"
            maxWidth="700.0"
            maxHeight="350.0"
            style="-fx-background-color: transparent;">

    <children>

        <!-- Fond pixel art (même que Settings principal) -->
        <ImageView fx:id="backgroundImage"
                   fitWidth="700.0"
                   fitHeight="350.0"
                   preserveRatio="false"
                   AnchorPane.topAnchor="0.0"
                   AnchorPane.leftAnchor="0.0">
            <image>
                <Image url="@../img/Assets/SettingsBackground.png" />
            </image>
        </ImageView>

        <!-- Contenu central -->
        <StackPane AnchorPane.topAnchor="0.0"
                   AnchorPane.bottomAnchor="0.0"
                   AnchorPane.leftAnchor="0.0"
                   AnchorPane.rightAnchor="0.0">
            <children>
                <VBox alignment="TOP_CENTER"
                      spacing="18.0"
                      prefWidth="420.0"
                      maxWidth="420.0"
                      style="-fx-background-color: transparent;">
                    <padding>
                        <Insets top="52.0" right="40.0" bottom="20.0" left="40.0"/>
                    </padding>
                    <children>

                        <!-- Titre image (même asset que Settings principal) -->
                        <ImageView fitWidth="280.0"
                                   fitHeight="50.0"
                                   preserveRatio="true"
                                   smooth="true">
                            <image>
                                <Image url="@../img/Assets/LabelTitleSettingsModal.png" />
                            </image>
                        </ImageView>

                        <VBox spacing="16.0" alignment="CENTER_LEFT"
                              style="-fx-background-color: transparent;">
                            <children>

                                <!-- MUSIC -->
                                <HBox spacing="12.0" alignment="CENTER_LEFT">
                                    <Label text="MUSIC"
                                           prefWidth="130.0"
                                           style="-fx-text-fill: white;
                                                  -fx-font-family: 'Consolas';
                                                  -fx-font-size: 14;
                                                  -fx-font-weight: bold;" />
                                    <Slider fx:id="musicSlider" prefWidth="200.0" value="50" min="0" max="100"/>
                                </HBox>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </StackPane>

        <!-- Bouton fermer (X) — même asset que Settings principal -->
        <Button fx:id="closeButton"
                onAction="#onClose"
                contentDisplay="GRAPHIC_ONLY"
                pickOnBounds="true"
                AnchorPane.topAnchor="50.0"
                AnchorPane.rightAnchor="45.0"
                style="-fx-background-color: transparent;
                       -fx-padding: 0;
                       -fx-border-color: transparent;
                       -fx-cursor: hand;">
            <graphic>
                <ImageView fitWidth="44.0"
                           fitHeight="44.0"
                           preserveRatio="true"
                           smooth="true">
                    <image>
                        <Image url="@../img/Assets/ExitBtnModal.png" />
                    </image>
                </ImageView>
            </graphic>
        </Button>

    </children>
</AnchorPane>
