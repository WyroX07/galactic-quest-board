<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.controller.MenuController">

    <!-- Background -->
    <ImageView fx:id="backgroundImage" preserveRatio="false" fitWidth="1920" fitHeight="1080">
        <image><Image url="@../img/Main_BackGround.png" /></image>
    </ImageView>

    <!-- Center buttons : Play + Settings -->
    <VBox alignment="CENTER" spacing="18" translateY="150">

        <Button fx:id="playButton" onAction="#onPlay"
                style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <ImageView fitWidth="240" preserveRatio="true">
                    <image><Image url="@../img/Assets/PlayBtn.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <Button fx:id="settingsButton" onAction="#onOptions"
                style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <ImageView fitWidth="300" preserveRatio="true">
                    <image><Image url="@../img/Assets/SettingsMainBtn.png" /></image>
                </ImageView>
            </graphic>
        </Button>

    </VBox>

    <!-- Corner buttons -->
    <AnchorPane pickOnBounds="false">

        <!-- Rules — top right, shows the same rules image used in-game -->
        <Button fx:id="rulesButton" onAction="#onRules"
                AnchorPane.topAnchor="18" AnchorPane.rightAnchor="18"
                style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <ImageView fitWidth="60" preserveRatio="true">
                    <image><Image url="@../img/Assets/RulesBtn.png" /></image>
                </ImageView>
            </graphic>
        </Button>

        <!-- Exit — bottom right, closes the application -->
        <Button fx:id="exitButton" onAction="#onExit"
                AnchorPane.bottomAnchor="18" AnchorPane.rightAnchor="18"
                style="-fx-background-color: transparent; -fx-padding: 0; -fx-cursor: hand;">
            <graphic>
                <ImageView fitWidth="110" preserveRatio="true">
                    <image><Image url="@../img/Assets/ExitBtnModal.png" /></image>
                </ImageView>
            </graphic>
        </Button>

    </AnchorPane>

    <!--
        Rules overlay — hidden by default. Reuses the exact same HelpModal.png
        image shown in-game (it already contains the full rules text), just
        without the two dynamic fields since there is no active game yet.
    -->
    <StackPane fx:id="rulesModalOverlay"
               visible="false"
               style="-fx-background-color: rgba(0,0,0,0.65);">

        <StackPane maxWidth="920.0" maxHeight="524.0">
            <ImageView fitWidth="920.0" fitHeight="524.0" preserveRatio="true" smooth="true">
                <image><Image url="@../img/Assets/HelpModal.png" /></image>
            </ImageView>

            <AnchorPane pickOnBounds="false" style="-fx-background-color: transparent;">
                <Button onAction="#onCloseRules"
                        contentDisplay="GRAPHIC_ONLY" pickOnBounds="true"
                        AnchorPane.topAnchor="60.0" AnchorPane.rightAnchor="130.0"
                        style="-fx-background-color: transparent; -fx-padding: 0;
                               -fx-border-color: transparent; -fx-cursor: hand;">
                    <graphic>
                        <ImageView fitWidth="44.0" fitHeight="44.0" preserveRatio="true" smooth="true">
                            <image><Image url="@../img/Assets/ExitBtnModal.png" /></image>
                        </ImageView>
                    </graphic>
                </Button>
            </AnchorPane>
        </StackPane>
    </StackPane>

</StackPane>
